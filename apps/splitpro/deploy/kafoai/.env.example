# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=splitpro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=splitpro
POSTGRES_PORT=5432
DATABASE_URL=postgresql://splitpro:change-me-strong-password@splitpro-db:5432/splitpro

# --- Public URL ---
NEXTAUTH_URL=https://splitpro.kafoai.com
NEXTAUTH_URL_INTERNAL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Skip the marketing landing page; open straight into the app.
DEFAULT_HOMEPAGE=/balances
ENABLE_SENDING_INVITES=false
DISABLE_EMAIL_SIGNUP=false

# --- Sign-in: configure AT LEAST ONE ---
# Option A (recommended): single sign-on with KafoAI accounts via OIDC.
# Register a client in KafoAI's identity provider with redirect URI:
#   https://splitpro.kafoai.com/api/auth/callback/kafoai
OIDC_NAME=KafoAI
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_WELL_KNOWN_URL=
# OIDC_ALLOW_DANGEROUS_EMAIL_LINKING=1
# With OIDC as the only provider, skip the sign-in page entirely:
OAUTH_AUTO_REDIRECT=true

# Option B: Google login (redirect URI https://splitpro.kafoai.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Option C: email magic link / OTP
FROM_EMAIL=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# --- Optional ---
CURRENCY_RATE_PROVIDER=frankfurter
UPLOAD_MAX_FILE_SIZE_MB=10
# npx web-push generate-vapid-keys --json
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_EMAIL=
